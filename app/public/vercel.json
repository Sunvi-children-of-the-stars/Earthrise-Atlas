{
  "rewrites": [
    { "source": "/((?!data/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/data/(.*)\\.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/data/(.*)\\.(i16|u8|f32)", "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }] }
  ]
}
